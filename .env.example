# =============================================================================
# SmartCitizen - Environment Configuration Template (Academic Project)
# =============================================================================
# Copy this file to '.env' or '.env.local' to customize local runtime settings.
# Note: In this frontend demo, application state persists in browser localStorage.

# Application Configuration
VITE_APP_TITLE="SmartCitizen"
VITE_APP_MODE="demo"
VITE_APP_VERSION="1.0.0"

# Optional Backend API URL (for future REST / GraphQL integration)
VITE_API_BASE_URL="http://localhost:5000/api"

# Map Services / Third-Party Placeholders
VITE_MAP_TILE_PROVIDER="openstreetmap"
